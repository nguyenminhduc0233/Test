<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee
             http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         version="3.0">
    
    <!-- Spring Context Listener -->
    <listener>
        <listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>
    </listener>

    <!-- Spring DispatcherServlet -->
    <servlet>
        <servlet-name>action</servlet-name>
        <servlet-class>org.springframework.web.struts.DelegatingRequestProcessor</servlet-class>
    </servlet>

    <!-- Mappings for DispatcherServlet -->
    <servlet-mapping>
        <servlet-name>action</servlet-name>
        <url-pattern>*.do</url-pattern>
    </servlet-mapping>

    <!-- Filter Mapping for Struts -->
    <filter>
        <filter-name>struts</filter-name>
        <filter-class>org.apache.struts.action.ActionServlet</filter-class>
        <init-param>
            <param-name>config</param-name>
            <param-value>/WEB-INF/struts-config.xml</param-value>
        </init-param>
        <init-param>
            <param-name>debug</param-name>
            <param-value>1</param-value>
        </init-param>
        <init-param>
            <param-name>log</param-name>
            <param-value>2</param-value>
        </init-param>
    </filter>

    <filter-mapping>
        <filter-name>struts</filter-name>
        <url-pattern>*.do</url-pattern>
    </filter-mapping>

    <!-- Spring Bean Configuration Location -->
    <context-param>
        <param-name>contextConfigLocation</param-name>
        <param-value>/WEB-INF/spring-config.xml</param-value>
    </context-param>
</web-app>

//    Giải thích:
//    ContextLoaderListener: Lắng nghe sự kiện khởi tạo của ứng dụng Spring.
//    DelegatingRequestProcessor: Cung cấp khả năng xử lý các request từ Struts và chuyển tiếp chúng qua Spring.
//    Filter Struts: Cấu hình Struts để xử lý các request với .do và liên kết với struts-config.xml.
//    Servlet Mapping: Chỉ định DispatcherServlet để nhận các request phù hợp với *.do.
