<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC "-//Hibernate/Hibernate Configuration DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-configuration-3.0.dtd">
<hibernate-configuration>

    <!-- Cấu hình kết nối database -->
    <session-factory>
        <!-- Driver class cho SQL Server -->
        <property name="hibernate.connection.driver_class">com.microsoft.sqlserver.jdbc.SQLServerDriver</property>
        <!-- URL kết nối -->
        <property name="hibernate.connection.url">jdbc:sqlserver://localhost:1433;databaseName=your_database</property>
        <!-- Username và password -->
        <property name="hibernate.connection.username">your_username</property>
        <property name="hibernate.connection.password">your_password</property>

        <!-- Dòng các Hibernate property -->
        <property name="hibernate.dialect">org.hibernate.dialect.SQLServerDialect</property>
        <property name="hibernate.hbm2ddl.auto">update</property> <!-- update, validate, create, create-drop -->
        <property name="hibernate.show_sql">true</property> <!-- Hiển thị các câu truy vấn SQL -->
        <property name="hibernate.format_sql">true</property>

        <!-- Cấu hình cache (tuỳ chọn) -->
        <property name="hibernate.cache.use_second_level_cache">true</property>
        <property name="hibernate.cache.region.factory_class">org.hibernate.cache.ehcache.EhCacheRegionFactory</property>
    </session-factory>

</hibernate-configuration>


//    Giải thích:
//    hibernate.connection.driver_class: Chỉ định driver JDBC cho MySQL.
//    hibernate.connection.url, username, password: Cấu hình kết nối đến cơ sở dữ liệu.
//    hibernate.dialect: Chỉ định dialect phù hợp cho MySQL.
//    hibernate.hbm2ddl.auto: Cấu hình cách Hibernate tự động tạo hoặc cập nhật schema của cơ sở dữ liệu.
//    mapping class: Đảm bảo Hibernate biết các entity class cần được ánh xạ (ví dụ: User).
